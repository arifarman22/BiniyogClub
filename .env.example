# Database (Neon PostgreSQL)
# Pooled connection for app queries
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/biniyog_club?sslmode=require"
# Direct connection for Prisma migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.neon.tech/biniyog_club?sslmode=require"

# Authentication
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Seed credentials (development only — never use in production)
SEED_SUPER_ADMIN_EMAIL="superadmin@biniyog.dev"
SEED_SUPER_ADMIN_PASSWORD="<your-super-admin-password>"
SEED_ADMIN_EMAIL="admin@biniyog.dev"
SEED_ADMIN_PASSWORD="<your-admin-password>"
SEED_INVESTOR_EMAIL="investor@biniyog.dev"
SEED_INVESTOR_PASSWORD="<your-investor-password>"
SEED_FARMER_EMAIL="farmer@biniyog.dev"
SEED_FARMER_PASSWORD="<your-farmer-password>"
SEED_FIELD_OFFICER_EMAIL="officer@biniyog.dev"
SEED_FIELD_OFFICER_PASSWORD="<your-field-officer-password>"

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASS="smtp-password"
SMTP_FROM="Biniyog Club <noreply@example.com>"

# Object Storage (future)
# STORAGE_PROVIDER="s3"
# AWS_REGION="us-east-1"
# AWS_BUCKET_NAME="biniyog-club-assets"
# AWS_ACCESS_KEY_ID=""
