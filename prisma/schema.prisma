// ─── Distribution ─────────────────────────────────────────────────────────────

model DistributionRule {
  id               String   @id @default(uuid())
  projectId        String   @unique
  investorSharePct Decimal  @db.Decimal(6, 4)
  platformFeePct   Decimal  @db.Decimal(6, 4)
  notes            String?
  createdBy        String
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batches DistributionBatch[]

  @@index([projectId])
  @@map("distribution_rules")
}

model DistributionBatch {
  id               String                  @id @default(uuid())
  projectId        String
  ruleId           String
  status           DistributionBatchStatus @default(DRAFT)
  ruleSnapshot     Json
  totalRevenueBdt  Decimal                 @db.Decimal(14, 2)
  totalExpensesBdt Decimal                 @db.Decimal(14, 2)
  netRevenueBdt    Decimal                 @db.Decimal(14, 2)
  investorPoolBdt  Decimal                 @db.Decimal(14, 2)
  totalGrossBdt    Decimal                 @db.Decimal(14, 2)
  totalFeeBdt      Decimal                 @db.Decimal(14, 2)
  totalNetBdt      Decimal                 @db.Decimal(14, 2)
  notes            String?
  createdBy        String
  submittedBy      String?
  submittedAt      DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  postedBy         String?
  postedAt         DateTime?
  voidedBy         String?
  voidedAt         DateTime?
  voidReason       String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rule      DistributionRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  lineItems DistributionLineItem[]

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@map("distribution_batches")
}

model DistributionLineItem {
  id                  String                 @id @default(uuid())
  batchId             String
  investmentId        String
  investorUserId      String
  investorSharePct    Decimal                @db.Decimal(10, 6)
  principalBdt        Decimal                @db.Decimal(14, 2)
  grossAmountBdt      Decimal                @db.Decimal(14, 2)
  platformFeeBdt      Decimal                @db.Decimal(14, 2)
  netAmountBdt        Decimal                @db.Decimal(14, 2)
  status              DistributionLineStatus @default(PENDING)
  ledgerTransactionId String?
  postedAt            DateTime?
  voidedAt            DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  batch      DistributionBatch @relation(fields: [batchId], references: [id])
  investment Investment        @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([investmentId])
  @@index([investorUserId])
  @@index([status])
  @@map("distribution_line_items")
}
