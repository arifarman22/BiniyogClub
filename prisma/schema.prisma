generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model BusinessGroup {
  id          String        @id @default(uuid())
  slug        GroupSlug     @unique
  name        String
  tagline     String?
  description String
  logoUrl     String?
  coverUrl    String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  entities    GroupEntity[]
  projects    Project[]

  @@map("business_groups")
}

model GroupEntity {
  id          String        @id @default(uuid())
  groupId     String
  name        String
  slug        String        @unique
  description String
  logoUrl     String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  group       BusinessGroup @relation(fields: [groupId], references: [id])
  tiers       GroupTier[]

  @@index([groupId])
  @@map("group_entities")
}

model GroupTier {
  id                String            @id @default(uuid())
  entityId          String
  type              TierType
  name              String
  description       String
  benefits          String[]          @default([])
  minAmountBdt      Decimal           @db.Decimal(14, 2)
  maxAmountBdt      Decimal?          @db.Decimal(14, 2)
  plotSizeSqft      Decimal?          @db.Decimal(10, 2)
  pricePerSqftBdt   Decimal?          @db.Decimal(10, 2)
  totalUnits        Int?
  availableUnits    Int?
  expectedReturnPct Decimal?          @db.Decimal(6, 4)
  durationMonths    Int?
  isActive          Boolean           @default(true)
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  investments       GroupInvestment[]
  entity            GroupEntity       @relation(fields: [entityId], references: [id])

  @@index([entityId])
  @@map("group_tiers")
}

model GroupInvestment {
  id              String                   @id @default(uuid())
  tierId          String
  investorUserId  String
  status          GroupInvestmentStatus    @default(PENDING)
  amountBdt       Decimal                  @db.Decimal(14, 2)
  plotNumber      String?
  plotSizeSqft    Decimal?                 @db.Decimal(10, 2)
  sharePercentage Decimal?                 @db.Decimal(6, 4)
  notes           String?
  receiptNumber   String?                  @unique
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  manualPayments  GroupInvestmentPayment[]
  investor        User                     @relation("GroupInvestments", fields: [investorUserId], references: [id])
  tier            GroupTier                @relation(fields: [tierId], references: [id])

  @@index([tierId])
  @@index([investorUserId])
  @@index([status])
  @@map("group_investments")
}

model GroupInvestmentPayment {
  id                String              @id @default(uuid())
  groupInvestmentId String
  submittedBy       String
  status            ManualPaymentStatus @default(SUBMITTED)
  amountBdt         Decimal             @db.Decimal(14, 2)
  bankAccountId     String
  transactionRef    String
  proofFileUrl      String
  proofMimeType     String
  notes             String?
  reviewedBy        String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  groupInvestment   GroupInvestment     @relation(fields: [groupInvestmentId], references: [id])

  @@index([groupInvestmentId])
  @@index([status])
  @@map("group_investment_payments")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  name               String
  phone              String?             @unique
  role               UserRole            @default(INVESTOR)
  status             UserStatus          @default(ACTIVE)
  avatarUrl          String?
  emailVerified      Boolean             @default(false)
  phoneVerified      Boolean             @default(false)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  auditLogs          AuditLog[]          @relation("AuditActor")
  documents          Document[]
  groupInvestments   GroupInvestment[]   @relation("GroupInvestments")
  investorProfile    InvestorProfile?
  kyc                Kyc?
  notifications      Notification[]
  managedProjects    Project[]           @relation("ProjectManager")
  sessions           Session[]
  verificationTokens VerificationToken[]
  wallet             Wallet?

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String                @id @default(uuid())
  userId    String
  token     String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId, type])
  @@map("verification_tokens")
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  description     String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         UserRole
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

model Kyc {
  id                String           @id @default(uuid())
  userId            String           @unique
  status            KycStatus        @default(NOT_STARTED)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedBy        String?
  reviewNote        String?
  expiresAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  fullName          String?
  dateOfBirth       DateTime?
  nationality       String?          @default("BD")
  addressLine       String?
  city              String?
  district          String?
  division          String?
  postalCode        String?
  presentAddress    String?
  presentDivision   String?
  presentDistrict   String?
  presentUpazila    String?
  presentPostOffice String?
  presentPostalCode String?
  permanentAddress    String?
  permanentDivision   String?
  permanentDistrict   String?
  permanentUpazila    String?
  permanentPostOffice String?
  permanentPostalCode String?
  documentType      KycDocumentType?
  documentNumber    String?
  bankName          String?
  bankAccountNumber String?
  mobileProvider    String?
  mobileNumber      String?
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents         KycDocument[]

  @@index([status])
  @@index([reviewedBy])
  @@map("kyc")
}

model KycDocument {
  id           String    @id @default(uuid())
  kycId        String
  documentType String
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  storageKey   String
  mimeType     String
  sizeBytes    Int
  kyc          Kyc       @relation(fields: [kycId], references: [id], onDelete: Cascade)

  @@index([kycId])
  @@map("kyc_documents")
}

model InvestorProfile {
  id                   String       @id @default(uuid())
  userId               String       @unique
  nationalId           String?      @unique
  nomineeNationalId    String?
  nomineeRelation      String?
  dateOfBirth          DateTime?
  address              String?
  city                 String?
  country              String       @default("BD")
  occupation           String?
  annualIncomeRange    String?
  investmentExperience String?
  riskTolerance        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  investments          Investment[]
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investor_profiles")
}

model Project {
  id                 String               @id @default(uuid())
  title              String
  slug               String               @unique
  description        String
  category           ProjectCategory
  status             ProjectStatus        @default(DRAFT)
  fundingGoalBdt     Decimal              @db.Decimal(14, 2)
  fundingMinBdt      Decimal              @db.Decimal(14, 2)
  fundedAmountBdt    Decimal              @default(0) @db.Decimal(14, 2)
  minInvestmentBdt   Decimal              @db.Decimal(14, 2)
  maxInvestmentBdt   Decimal?             @db.Decimal(14, 2)
  returnType         ReturnType
  expectedReturnPct  Decimal              @db.Decimal(6, 4)
  returnPctMin       Decimal?             @db.Decimal(6, 4)
  returnPctMax       Decimal?             @db.Decimal(6, 4)
  durationDays       Int
  fundingDeadline    DateTime
  startDate          DateTime?
  endDate            DateTime?
  coverImageUrl      String?
  reviewedBy         String?
  reviewedAt         DateTime?
  approvedAt         DateTime?
  publishedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  managerId          String?
  riskInfo           String?
  location           String?
  imageUrls          String[]             @default([])
  rejectionReason    String?
  groupId            String?
  documents          Document[]
  investments        Investment[]
  distributions      ProfitDistribution[]
  updates            ProjectUpdate[]
  distributionRule   DistributionRule?
  distributionBatches DistributionBatch[]
  bankAccounts        ProjectBankAccount[]
  manager            User?                @relation("ProjectManager", fields: [managerId], references: [id])
  group              BusinessGroup?       @relation(fields: [groupId], references: [id])

  @@index([managerId])
  @@index([groupId])
  @@index([status])
  @@index([category])
  @@index([slug])
  @@index([fundingDeadline])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectUpdate {
  id          String            @id @default(uuid())
  projectId   String
  authorId    String
  type        ProjectUpdateType
  title       String
  content     String
  isPublished Boolean           @default(true)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
  @@map("project_updates")
}

model Investment {
  id                 String                    @id @default(uuid())
  investorProfileId  String
  projectId          String
  status             InvestmentStatus          @default(PENDING)
  amountBdt          Decimal                   @db.Decimal(14, 2)
  expectedReturnBdt  Decimal                   @db.Decimal(14, 2)
  actualReturnBdt    Decimal?                  @db.Decimal(14, 2)
  returnType         ReturnType
  confirmedAt        DateTime?
  activatedAt        DateTime?
  maturedAt          DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  idempotencyKey     String?                   @unique
  paymentPendingAt   DateTime?
  refundedAt         DateTime?
  completedAt        DateTime?
  receiptNumber      String?                   @unique
  gatewayPayments    GatewayPayment[]
  contract           InvestmentContract?
  investorProfile    InvestorProfile           @relation(fields: [investorProfileId], references: [id])
  project            Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ledgerTransactions LedgerTransaction[]
  manualPayments     ManualPaymentSubmission[]
  distributions      ProfitDistribution[]
  distributionLines  DistributionLineItem[]

  @@index([investorProfileId])
  @@index([projectId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("investments")
}

model InvestmentContract {
  id              String         @id @default(uuid())
  investmentId    String         @unique
  status          ContractStatus @default(DRAFT)
  contractUrl     String?
  templateVersion String
  terms           Json
  sentAt          DateTime?
  signedAt        DateTime?
  signedByIp      String?
  expiresAt       DateTime?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  investment      Investment     @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("investment_contracts")
}

model ProfitDistribution {
  id             String     @id @default(uuid())
  projectId      String
  investmentId   String
  amountBdt      Decimal    @db.Decimal(14, 2)
  platformFeeBdt Decimal    @db.Decimal(14, 2)
  netAmountBdt   Decimal    @db.Decimal(14, 2)
  distributedAt  DateTime
  notes          String?
  createdAt      DateTime   @default(now())
  investment     Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([investmentId])
  @@index([distributedAt])
  @@map("profit_distributions")
}

model Wallet {
  id            String           @id @default(uuid())
  userId        String           @unique
  type          WalletType
  cachedBalance Decimal          @default(0) @db.Decimal(14, 2)
  currency      String           @default("BDT")
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  ledgerEntries LedgerEntry[]
  payments      Payment[]
  snapshots     WalletSnapshot[]
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals   Withdrawal[]

  @@index([type])
  @@map("wallets")
}

model WalletSnapshot {
  id            String   @id @default(uuid())
  walletId      String
  balanceBdt    Decimal  @db.Decimal(14, 2)
  ledgerEntryId String
  createdAt     DateTime @default(now())
  wallet        Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([createdAt])
  @@map("wallet_snapshots")
}

model LedgerTransaction {
  id             String                @id @default(uuid())
  type           LedgerTransactionType
  investmentId   String?
  referenceId    String?
  referenceType  String?
  description    String
  amountBdt      Decimal               @db.Decimal(14, 2)
  createdAt      DateTime              @default(now())
  status         LedgerTxStatus        @default(POSTED)
  idempotencyKey String?               @unique
  currency       String                @default("BDT")
  metadata       Json?
  postedAt       DateTime              @default(now())
  voidedAt       DateTime?
  voidReason     String?
  entries        LedgerEntry[]
  investment     Investment?           @relation(fields: [investmentId], references: [id])

  @@index([type])
  @@index([status])
  @@index([investmentId])
  @@index([referenceId, referenceType])
  @@index([idempotencyKey])
  @@index([postedAt])
  @@index([createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                  String            @id @default(uuid())
  ledgerTransactionId String
  walletId            String
  entryType           LedgerEntryType
  amountBdt           Decimal           @db.Decimal(14, 2)
  balanceAfterBdt     Decimal           @db.Decimal(14, 2)
  createdAt           DateTime          @default(now())
  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id])
  wallet              Wallet            @relation(fields: [walletId], references: [id])

  @@index([ledgerTransactionId])
  @@index([entryType])
  @@index([createdAt])
  @@index([walletId])
  @@map("ledger_entries")
}

model BankAccount {
  id            String   @id @default(uuid())
  bankName      String
  accountName   String
  accountNumber String
  routingNumber String?
  branchName    String?
  swiftCode     String?
  iban          String?
  mobileNumber  String?
  email         String?
  branchAddress String?
  instructions  String?
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
  @@map("bank_accounts")
}

model ProjectBankAccount {
  id             String   @id @default(uuid())
  projectId      String
  accountName    String
  accountNumber  String
  bankName       String
  branchName     String?
  routingNumber  String?
  swiftCode      String?
  mobileNumber   String?
  email          String?
  branchAddress  String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_bank_accounts")
}

model ManualPaymentSubmission {
  id              String              @id @default(uuid())
  investmentId    String
  submittedBy     String
  status          ManualPaymentStatus @default(SUBMITTED)
  amountBdt       Decimal             @db.Decimal(14, 2)
  bankAccountId   String?
  paymentMethod   String              @default("BANK_TRANSFER")
  transactionRef  String
  proofFileUrl    String
  proofMimeType   String
  notes           String?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  investment      Investment          @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId])
  @@index([status])
  @@index([submittedBy])
  @@index([createdAt])
  @@map("manual_payment_submissions")
}

model GatewayPayment {
  id                String               @id @default(uuid())
  investmentId      String
  walletId          String?
  provider          String
  status            GatewayPaymentStatus @default(INITIATED)
  amountBdt         Decimal              @db.Decimal(14, 2)
  currency          String               @default("BDT")
  idempotencyKey    String               @unique
  providerPaymentId String?
  providerOrderId   String?
  checkoutUrl       String?
  verifiedAt        DateTime?
  verifiedBy        String?
  expiresAt         DateTime?
  failureReason     String?
  providerMetadata  Json?
  callbackPayload   Json?
  refundedAt        DateTime?
  refundReference   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt
  investment        Investment           @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId])
  @@index([provider])
  @@index([status])
  @@index([idempotencyKey])
  @@index([providerPaymentId])
  @@index([createdAt])
  @@map("gateway_payments")
}

model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  eventId     String
  eventType   String
  processedAt DateTime @default(now())
  payload     Json

  @@unique([provider, eventId])
  @@index([provider, eventId])
  @@index([processedAt])
  @@map("webhook_events")
}

model Payment {
  id                String           @id @default(uuid())
  walletId          String
  direction         PaymentDirection
  method            PaymentMethod
  status            PaymentStatus    @default(PENDING)
  amountBdt         Decimal          @db.Decimal(14, 2)
  feeBdt            Decimal          @default(0) @db.Decimal(14, 2)
  netAmountBdt      Decimal          @db.Decimal(14, 2)
  currency          String           @default("BDT")
  externalReference String?
  gatewayResponse   Json?
  description       String?
  processedAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  refundedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  idempotencyKey    String?          @unique
  wallet            Wallet           @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([status])
  @@index([direction])
  @@index([idempotencyKey])
  @@index([externalReference])
  @@index([createdAt])
  @@map("payments")
}

model Withdrawal {
  id                  String           @id @default(uuid())
  walletId            String
  status              WithdrawalStatus @default(PENDING)
  amountBdt           Decimal          @db.Decimal(14, 2)
  feeBdt              Decimal          @default(0) @db.Decimal(14, 2)
  netAmountBdt        Decimal          @db.Decimal(14, 2)
  bankName            String?
  accountNumber       String?
  accountName         String?
  mobileNumber        String?
  method              PaymentMethod
  requestedAt         DateTime         @default(now())
  approvedAt          DateTime?
  approvedBy          String?
  processedAt         DateTime?
  completedAt         DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  idempotencyKey      String?          @unique
  ledgerTransactionId String?
  wallet              Wallet           @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@map("withdrawals")
}

model Document {
  id              String             @id @default(uuid())
  uploadedBy      String
  entityType      DocumentEntityType
  entityId        String
  category        DocumentCategory   @default(PROJECT_DOCUMENT)
  name            String
  description     String?
  fileUrl         String
  storageKey      String?
  mimeType        String
  sizeBytes       Int
  isPublic        Boolean            @default(false)
  isFinalized     Boolean            @default(false)
  templateVersion String?
  generatedAt     DateTime?
  expiresAt       DateTime?
  allowedRoles    String[]           @default([])
  ownerUserId     String?
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  project         Project            @relation(fields: [entityId], references: [id], onDelete: Cascade, map: "document_project_fk")
  uploader        User               @relation(fields: [uploadedBy], references: [id])
  auditLogs       DocumentAuditLog[]

  @@index([entityType, entityId])
  @@index([uploadedBy])
  @@index([category])
  @@index([ownerUserId])
  @@index([deletedAt])
  @@map("documents")
}

model DocumentAuditLog {
  id         String   @id @default(uuid())
  documentId String
  actorId    String?
  action     String
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([actorId])
  @@index([createdAt])
  @@map("document_audit_logs")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FINANCE_OFFICER
  PROJECT_MANAGER
  KYC_OFFICER
  SUPPORT
  INVESTOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  OTP
}

enum KycStatus {
  NOT_STARTED
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum KycDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVING_LICENSE
  UTILITY_BILL
  BANK_STATEMENT
  TAX_CERTIFICATE
  LAND_DEED
}

enum ProjectStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  FUNDRAISING
  FUNDED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProjectCategory {
  REAL_ESTATE
  TRADE_FINANCE
  SME
  TECHNOLOGY
  INFRASTRUCTURE
  OTHER
}

enum ProjectUpdateType {
  GENERAL
  MILESTONE
  ISSUE
  FINANCIAL_REPORT
}

enum InvestmentStatus {
  PENDING
  PAYMENT_PENDING
  ACTIVE
  MATURED
  CANCELLED
  REFUNDED
  COMPLETED
}

enum ReturnType {
  FIXED_RETURN
  PROFIT_SHARE
  HYBRID
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  EXPIRED
  VOIDED
}

enum WalletType {
  INVESTOR
  PLATFORM_REVENUE
  PLATFORM_ESCROW
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum LedgerTransactionType {
  INVESTMENT_FUNDING
  INVESTMENT_RETURN
